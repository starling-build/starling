diff --git a/src/main.zig b/src/main.zig
index cceca94..cd91faf 100644
--- a/src/main.zig
+++ b/src/main.zig
@@ -336,6 +336,10 @@ pub fn complete() !void {
 pub fn pause() !void {
     //todo - poll / read a keystroke w/out echo, \n etc
 
+    // BENCH: non-interactive when DOOMFIRE_FRAMES is set. Emits nothing extra,
+    // so the byte stream the terminal renders is unchanged.
+    if (std.posix.getenv("DOOMFIRE_FRAMES") != null) return;
+
     try emit(color_reset);
     try emit("Press return to continue...");
     var b: u8 = undefined;
@@ -621,7 +625,7 @@ pub fn showTermCap() !void {
 /// Below   - moderately faster
 
 //pixel character
-const px = "▀";
+const px = "#";
 
 //bs = buffer string
 var bs: []u8 = undefined;
@@ -690,6 +694,21 @@ pub fn paintBuf() !void {
 
     try emit(fg[0]);
     try emitFmt("mem: {s:.2} min / {s:.2} avg / {s:.2} max [ {d:.2} fps ]", .{ std.fmt.fmtIntSizeBin(bs_sz_min), std.fmt.fmtIntSizeBin(bs_sz_avg), std.fmt.fmtIntSizeBin(bs_sz_max), fps });
+
+    // BENCH: stop after a fixed number of frames so every terminal is asked
+    // for exactly the same work, and report on stderr where it cannot perturb
+    // the rendered stream.
+    if (std.posix.getenv("DOOMFIRE_FRAMES")) |lim_s| {
+        const lim = std.fmt.parseInt(u64, lim_s, 10) catch 600;
+        if (bs_frame_tic >= lim) {
+            std.io.getStdErr().writer().print(
+                "BENCHFPS frames={d} seconds={d:.3} fps={d:.2}\n",
+                .{ bs_frame_tic, t_dur, fps },
+            ) catch {};
+            try complete();
+            std.process.exit(0);
+        }
+    }
 }
 
