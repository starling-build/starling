+// BENCH: DOOMFIRE_FRAMES lookup that also compiles on Windows.
+// std.posix.getenv is a compile error there (environment strings are WTF-16),
+// so go through std.process, which is cross-platform. A fixed buffer keeps it
+// allocation-free and safe to call from the render loop.
+fn benchFrameLimit() ?u64 {
+    var buf: [64]u8 = undefined;
+    var fba = std.heap.FixedBufferAllocator.init(&buf);
+    const v = std.process.getEnvVarOwned(fba.allocator(), "DOOMFIRE_FRAMES") catch return null;
+    return std.fmt.parseInt(u64, v, 10) catch 600;
+}
