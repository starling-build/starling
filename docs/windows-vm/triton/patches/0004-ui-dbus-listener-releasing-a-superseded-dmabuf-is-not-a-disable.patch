 #endif
 
 #ifdef WIN32
@@ -597,6 +606,20 @@
 static void dbus_release_dmabuf(DisplayChangeListener *dcl,
                                 QemuDmaBuf *dmabuf)
 {
+    DBusDisplayListener *ddl = container_of(dcl, DBusDisplayListener, dcl);
+
+    /*
+     * A flip-model guest replaces the scanout every frame, and
+     * virtio_gpu_update_dmabuf frees the previous primary right after
+     * scanning out the new one. Releasing that older buffer is not the
+     * display going away: disabling here sent a Disable after every
+     * frame, and its ddl_discard_display_messages dropped the
+     * ScanoutDMABUF just queued for the new buffer, so the listener kept
+     * drawing the buffer the guest had moved on from.
+     */
+    if (ddl->dmabuf != dmabuf) {
+        return;
+    }
     dbus_scanout_disable(dcl);
 }
 #endif /* GBM */
