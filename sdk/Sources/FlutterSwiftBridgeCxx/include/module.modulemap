// The engine's Swift bridge headers, vendored into include/engine by
// tools/sync-engine-headers.sh. This list is the manifest that script reads —
// add a bridge header here and re-run it. Vendoring is what lets the package
// compile with no engine checkout; only linking still needs a built engine.
module FlutterSwiftBridgeCxx {
    header "engine/intrusive_reference_counted.h"
    header "engine/swift_bridge_export.h"
    header "engine/rsuperellipse_bridge.h"
    header "engine/channel_buffers_bridge.h"
    header "engine/shader_bridge.h"
    header "engine/gradient_bridge.h"
    header "engine/image_bridge.h"
    header "engine/image_shader_bridge.h"
    header "engine/fragment_program_bridge.h"
    header "engine/fragment_shader_bridge.h"
    header "engine/path_bridge.h"
    header "engine/path_measure_bridge.h"
    header "engine/vertices_bridge.h"
    header "engine/immutable_buffer_bridge.h"
    header "engine/color_filter_bridge.h"
    header "engine/image_filter_bridge.h"
    header "engine/codec_bridge.h"
    header "engine/canvas_bridge.h"
    header "engine/picture_bridge.h"
    header "engine/pdf_bridge.h"
    header "engine/image_descriptor_bridge.h"
    header "engine/engine_layer_bridge.h"
    header "engine/scene_bridge.h"
    header "engine/scene_builder_bridge.h"
    header "engine/platform_dispatcher_bridge.h"
    header "engine/semantics_flags_bridge.h"
    header "engine/spell_out_string_attribute_bridge.h"
    header "engine/locale_string_attribute_bridge.h"
    header "engine/semantics_update_bridge.h"
    header "engine/semantics_update_builder_bridge.h"
    header "engine/paragraph_bridge.h"
    header "engine/paragraph_builder_bridge.h"
    header "engine/font_collection_bridge.h"
    header "engine/view_bridge.h"
    header "engine/swift_runtime_callbacks.h"
    export *
    requires cplusplus
}
