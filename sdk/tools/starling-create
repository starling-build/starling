#!/usr/bin/env bash
# starling-create — start a Starling app from nothing.
#
#   curl -fLO https://github.com/starling-build/starling/releases/download/terminal-v0.1.0/starling-create
#   chmod +x starling-create
#   ./starling-create myterm && cd myterm && swift run -c release
#
# One file, shipped as an asset on the Starling Terminal release — the same
# release that carries the terminal itself — so the tool and the SDK bundle it
# fetches are versioned together and come from one tag. It checks your
# toolchain, downloads the SDK — the Flutter-to-Swift framework plus the engine
# binaries it links against — and writes a SwiftPM project wired to it. There
# is no repo to clone, no engine checkout, no Flutter install and no system
# Flutter anywhere in that.
#
#   ./starling-create [name] [options]
#
#     --template terminal|app   what to scaffold (default: terminal)
#     --run                     build and run it when the project is written
#     --sdk <url|file>          the SDK bundle to install — a URL to download,
#                               or an archive already on disk. Defaults to the
#                               release this tool ships on.
#     --force                   overwrite an existing directory
#     -h, --help
#
# The SDK is cached under ~/.starling/sdk and shared by every
# project, so the second project costs no download. The project gets an `sdk`
# symlink into that cache, which is what its Package.swift depends on by path —
# except on Windows, where Git bash cannot make one and the manifest names the
# cache directly instead.
#
# Linux, macOS and Windows. On Windows run it from Git bash, which is where a
# `curl | bash` instruction lands anyway; the bundle it fetches is the .zip.
#
#   STARLING_SDK_URL    same as --sdk
#   STARLING_SDK_HOME   cache location, default ~/.starling/sdk
set -euo pipefail

# Where the SDK comes from. ONE line to bump when cutting a release: a tool
# downloaded from a tag should install that tag's SDK rather than drift to
# whatever is newest. --sdk overrides it with any URL, or a local archive.
SDK_BASE_URL="https://github.com/starling-build/starling/releases/download/terminal-v0.1.0"
GH_REPO="starling-build/starling"
SDK_URL="${STARLING_SDK_URL:-}"
NAME=""
TEMPLATE=terminal
RUN=0
FORCE=0

die() { echo "error: $*" >&2; exit 1; }
say() { printf '%s\n' "$*"; }

# Everything from line 2 down to the `set` line, comments only — so editing the
# header above cannot silently truncate --help the way a fixed line range does.
usage() { sed -n '2,/^set -euo/p' "$0" | grep '^#' | sed 's/^# \{0,1\}//'; exit 0; }

while [ $# -gt 0 ]; do
    case "$1" in
        --template)    TEMPLATE="${2:-}"; shift 2 ;;
        --template=*)  TEMPLATE="${1#*=}"; shift ;;
        --sdk)         SDK_URL="${2:-}"; shift 2 ;;
        --sdk=*)       SDK_URL="${1#*=}"; shift ;;
        --run)         RUN=1; shift ;;
        --force)       FORCE=1; shift ;;
        -h|--help)     usage ;;
        -*)            die "unknown option: $1  (--help for usage)" ;;
        *)             [ -z "$NAME" ] || die "more than one name given: $NAME, $1"
                       NAME="$1"; shift ;;
    esac
done

NAME="${NAME:-starling-terminal}"
case "$TEMPLATE" in
    terminal|app) ;;
    *) die "unknown template '$TEMPLATE' — use terminal or app" ;;
esac

# A SwiftPM target name must be an identifier; the directory can be anything.
# "my-term" is a perfectly good directory and an invalid module, so derive one
# rather than failing on it.
MODULE="$(printf '%s' "$NAME" | sed 's/[^A-Za-z0-9]\+/ /g' |
          awk '{for(i=1;i<=NF;i++) printf "%s%s", toupper(substr($i,1,1)), substr($i,2)}')"
[ -n "$MODULE" ] || MODULE=App
case "$MODULE" in [0-9]*) MODULE="App$MODULE" ;; esac

# --- prerequisites -----------------------------------------------------------
command -v swift >/dev/null 2>&1 || die "no swift toolchain on PATH.
       Install one from https://swift.org/install (6.0 or newer)."
command -v curl >/dev/null 2>&1 || die "curl is needed to fetch the SDK."

# MINGW/MSYS/CYGWIN is Git for Windows' bash, which is what a Windows user has
# when they run this file. WSL reports Linux and is Linux — it wants the Linux
# bundle and gets it, correctly, from the case above.
case "$(uname -s)" in
    Linux)                PLATFORM=linux ;;
    Darwin)               PLATFORM=macos ;;
    MINGW*|MSYS*|CYGWIN*) PLATFORM=windows ;;
    *) die "unsupported platform $(uname -s).
       Use the repo checkout: https://github.com/$GH_REPO" ;;
esac
ARCH="$(uname -m)"
BUNDLE="starling-sdk-$PLATFORM-$ARCH"

# The Windows bundle is a .zip and the other two are tarballs, so the extension
# is part of the artifact's name everywhere it is used: the default download URL
# and the unpack. The marker file is what proves a cached directory is a real
# bundle rather than a half-unpacked one.
if [ "$PLATFORM" = windows ]; then
    EXT=zip
    ENGINE_MARKER=engine/lib/flutter_engine.dll
else
    EXT=tar.gz
    ENGINE_MARKER=engine/lib/libflutter_engine.so
fi

# The runtime libraries the windowed host loads. They are the one thing the
# bundle cannot carry — GTK pulls in a large part of the desktop — so name them
# now rather than letting the app die at startup on a missing .so.
if [ "$PLATFORM" = linux ]; then
    # One snapshot, matched by the shell. `ldconfig -p | grep -q "$lib"` is the
    # obvious spelling and is a race under `set -o pipefail`: -q exits at the
    # first match, ldconfig dies of SIGPIPE writing the rest, and the pipeline
    # reports failure — so a library that IS installed is reported missing. It
    # fired on 2 runs in 8 here and told a user with GTK installed to install
    # GTK, in the tool's very first output. Same trap
    # build/package-terminal-gtk.sh documents against readelf.
    LDCACHE="$(ldconfig -p 2>/dev/null || true)"
    MISSING=""
    for lib in libgtk-3.so.0 libEGL.so.1 libGLESv2.so.2; do
        case "$LDCACHE" in *"$lib"*) ;; *) MISSING="$MISSING $lib" ;; esac
    done
    if [ -n "$MISSING" ]; then
        say "warning: these runtime libraries are missing:$MISSING"
        say "         on Debian/Ubuntu: sudo apt install libgtk-3-0 libegl1 libgles2"
        say ""
    fi
fi

# --- the SDK -----------------------------------------------------------------
SDK_HOME="${STARLING_SDK_HOME:-$HOME/.starling/sdk}"
SDK_DIR="$SDK_HOME/$BUNDLE"
SDK_URL="${SDK_URL:-$SDK_BASE_URL/$BUNDLE.$EXT}"
# What the cache was filled from. It is keyed by platform rather than by
# version, so without this a run with a different --sdk would find a populated
# directory and silently keep the first SDK.
SDK_STAMP="$SDK_DIR/.source"

fetch_sdk() {
    mkdir -p "$SDK_HOME"
    local work; work="$(mktemp -d)"
    # shellcheck disable=SC2064
    trap "rm -rf '$work'" RETURN

    local tarball
    if [ -f "$SDK_URL" ]; then
        say "==> using $SDK_URL"
        tarball="$SDK_URL"
    else
        say "==> downloading the Starling SDK"
        say "    $SDK_URL"
        tarball="$work/$BUNDLE.$EXT"
        curl -fL --progress-bar -o "$tarball" "$SDK_URL" || die "could not fetch
       $SDK_URL
       Check https://github.com/$GH_REPO/releases for a bundle matching
       $PLATFORM/$ARCH, or pass --sdk with a URL or a local archive."
    fi

    say "==> unpacking into $SDK_DIR"
    if [ "$EXT" = zip ]; then
        # Git for Windows carries no unzip(1). PowerShell is always there, and
        # needs Windows paths, so hand it converted ones rather than the MSYS
        # spellings that everything else here uses.
        if command -v unzip >/dev/null 2>&1; then
            unzip -q "$tarball" -d "$work"
        else
            powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \
                "Expand-Archive -LiteralPath '$(cygpath -w "$tarball")' -DestinationPath '$(cygpath -w "$work")' -Force" \
                || die "could not unpack $BUNDLE.$EXT"
        fi
    else
        tar -xzf "$tarball" -C "$work"
    fi
    [ -d "$work/$BUNDLE" ] || die "$BUNDLE.$EXT did not contain $BUNDLE/"
    rm -rf "$SDK_DIR.partial"
    mv "$work/$BUNDLE" "$SDK_DIR.partial"
    # Move into place last, so an interrupted run never leaves a half-unpacked
    # tree that the next run would happily treat as a cache hit.
    rm -rf "$SDK_DIR"
    mv "$SDK_DIR.partial" "$SDK_DIR"
    printf '%s\n' "$SDK_URL" > "$SDK_STAMP"
}

if [ -d "$SDK_DIR" ] && { [ -f "$SDK_DIR/$ENGINE_MARKER" ] ||
                          [ -d "$SDK_DIR/engine/lib/FlutterMacOS.framework" ]; } &&
   [ "$(cat "$SDK_STAMP" 2>/dev/null)" = "$SDK_URL" ]; then
    say "==> SDK already cached at $SDK_DIR"
else
    fetch_sdk
fi

# --- the project -------------------------------------------------------------
# Written as ifs, not an && chain: under `set -e` a chain whose final test is
# false takes the whole script down with it, so `--force` would exit 1 here
# having done nothing at all.
if [ -e "$NAME" ]; then
    if [ "$FORCE" = 0 ]; then
        die "$NAME already exists — pass --force to overwrite it"
    fi
    rm -rf "$NAME"
fi

say "==> writing $NAME/ ($TEMPLATE)"
mkdir -p "$NAME/Sources/$MODULE"
# How the project refers to the SDK. Everywhere but Windows that is an `sdk`
# symlink into the shared cache, so the project stays relocatable and tiny.
# Git for Windows has no usable symlink without Developer Mode -- `ln -s`
# silently DEEP COPIES instead, which would put a 100+ MB copy of the SDK in
# every project and leave it stale when the cache updates. So on Windows the
# manifest names the cache directly, in the forward-slash spelling Windows
# accepts and a Swift string literal needs no escaping for.
if [ "$PLATFORM" = windows ]; then
    SDK_REF="$(cygpath -m "$SDK_DIR" 2>/dev/null || printf '%s' "$SDK_DIR")"
    SDK_SHOWN="Package.swift -> $SDK_REF"
else
    ln -sfn "$SDK_DIR" "$NAME/sdk"
    SDK_REF="sdk"
    SDK_SHOWN="sdk -> $SDK_DIR"
fi

cat > "$NAME/Package.swift" <<PACKAGE
// swift-tools-version: 6.0
import PackageDescription
import Foundation

// Where the SDK is: the framework and the engine binaries it links against.
// On Linux and macOS ./sdk is a symlink into the shared cache
// (~/.starling/sdk). On Windows it is that cache path spelled out, because Git
// bash cannot create a symlink there without Developer Mode.
//
// A path dependency rather than .package(url:from:) is inherent, not a
// shortcut: locating the bundled engine needs -L/-rpath, which SwiftPM
// classifies as unsafe flags and permits for path dependencies only. You do
// not add the engine library here and you do not set a library path — the
// SDK's own linker settings do both, and bake the rpath into this executable.
// Two constants, not one, because they are two different things: where the
// package IS, and what it is CALLED in \`package:\` references. SwiftPM derives
// a path dependency's identity from its last path component, so with the
// symlink spelling ("sdk") the two coincide and one constant hides the
// difference -- until Windows names an absolute path here and every
// \`package: sdk\` stops resolving, with "unknown package ...; valid packages
// are: starling-sdk-windows-x86_64-<tag>". Naming the dependency pins it.
let sdkPath = "$SDK_REF"
let sdkName = "sdk"

// Ubuntu 26.04 (glibc 2.43 + libstdc++ 15) needs two flags on any C++-interop
// target, and swiftSettings are NOT inherited from a dependency — so the SDK
// applying them internally does nothing here. Without them the build fails
// inside Foundation's C shim with "cmath: redefinition of 'acos'".
// libstdc++ 15 is the discriminator: 24.04 ships 13/14, 26.04 ships 15.
func needsGlibcMathCompat() -> Bool {
    if let forced = ProcessInfo.processInfo.environment["FLUTTER_SWIFT_GLIBC_MATH_COMPAT"],
       !forced.isEmpty {
        return forced != "0"
    }
    let fm = FileManager.default
    guard fm.fileExists(atPath: "/usr/include/math.h") else { return false }
    let newest = ((try? fm.contentsOfDirectory(atPath: "/usr/include/c++")) ?? [])
        .compactMap { Int(\$0) }.max() ?? 0
    return newest >= 15
}

#if os(Linux)
let glibcMathCompat = needsGlibcMathCompat()
    ? ["-Xcc", "-D_GLIBCXX_MATH_H", "-Xcc", "-include", "-Xcc", "/usr/include/math.h"]
    : []
#else
let glibcMathCompat: [String] = []
#endif

// .interoperabilityMode(.Cxx) is required: the framework is C++-interop and
// that setting is not inherited either. Without it the build stops at
// "module 'FlutterSwiftBridgeCxx' requires feature 'cplusplus'".
let appSettings: [SwiftSetting] = [.interoperabilityMode(.Cxx), .swiftLanguageMode(.v5)]
    + (glibcMathCompat.isEmpty ? [] : [.unsafeFlags(glibcMathCompat)])

let package = Package(
    name: "$NAME",
    // Without this the executable defaults to macOS 10.13 and SwiftPM refuses
    // to link the SDK's macOS-14 products. Linux ignores it.
    platforms: [.macOS(.v14)],
    dependencies: [
        .package(name: sdkName, path: sdkPath),
    ],
    targets: [
        .executableTarget(
            name: "$MODULE",
            dependencies: [
                // The framework: widgets, rendering, gestures — and TerminalView.
                .product(name: "Flutter", package: sdkName),
                // The windowed host: opens the window, starts the engine in
                // Swift mode, mounts the widget. runExampleApp lives here.
                .product(name: "ExampleHost", package: sdkName),
                // The dart:ui types — Offset, Size, Rect, Paint, Canvas.
                // Separate from Flutter, which does not re-export them.
                .product(name: "FlutterSwiftBridge", package: sdkName),
                // Glyphs, for anything with an Icon in it.
                .product(name: "CupertinoIcons", package: sdkName),
            ],
            path: "Sources/$MODULE",
            swiftSettings: appSettings
        ),
    ]
)
PACKAGE

if [ "$TEMPLATE" = terminal ]; then
cat > "$NAME/Sources/$MODULE/main.swift" <<'SOURCE'
// A terminal, in full.
//
// TerminalSession spawns your shell; TerminalView renders it. Everything a
// terminal actually needs — the C emulator core, the glyph atlas, scrollback,
// selection, mouse reporting, wide characters and grapheme clusters, the
// bundled fonts — comes with the widget.

import ExampleHost
import Flutter

let session = TerminalSession()
session.startShell()

runExampleApp(title: "Terminal", width: 940, height: 620) {
    TerminalView(session: session)
}
SOURCE
else
cat > "$NAME/Sources/$MODULE/main.swift" <<'SOURCE'
// A window with a widget tree in it. Everything below is ordinary Swift —
// there is no Dart VM and no code generation anywhere in this app.

import ExampleHost
import Flutter
import FlutterSwiftBridge

class MyApp: StatelessWidget {
    override func build(_ context: any BuildContext) -> Widget {
        // Directionality is not optional: a tree with no app widget above it
        // has no text direction to inherit, and the first Text you render
        // brings the process down. Every root here needs one.
        return Directionality(textDirection: .ltr, child: HomePage())
    }
}

class HomePage: StatelessWidget {
    override func build(_ context: any BuildContext) -> Widget {
        return MaterialScaffold(
            appBar: MaterialAppBar(title: "Hello, Starling"),
            body: Center(
                child: Column(
                    mainAxisAlignment: .center,
                    children: [
                        Text(
                            "It runs.",
                            style: TextStyle(color: MaterialColors.headline, fontSize: 34)
                        ),
                        Text(
                            "Edit Sources/main.swift and build again.",
                            style: TextStyle(color: MaterialColors.body, fontSize: 14)
                        ),
                    ]
                )
            )
        )
    }
}

runExampleApp(title: "Hello, Starling", width: 480, height: 720) { MyApp() }
SOURCE
fi

cat > "$NAME/.gitignore" <<'IGNORE'
.build/
sdk
IGNORE

# The README's two platform-shaped paragraphs: how this project finds the SDK,
# and what shipping it means. Built here because a heredoc cannot hold an `if`.
# Quoted delimiters keep backticks and backslashes literal -- Windows paths are
# full of the latter -- and @MODULE@ is substituted after, so nothing in the
# text has to be escaped for the shell.
#
# Written to FILES, not captured into variables. The obvious spelling --
# VAR="$(cat <<'NOTE' | sed ...)" -- is a SYNTAX ERROR in bash 3.2, which is
# what macOS ships as /bin/bash: a here-document inside a command substitution
# has its quotes parsed by the outer $( ), so the first apostrophe in the prose
# ("the executable's own directory", "someone else's machine") opens a quoted
# string that never closes. bash 5 parses it correctly, so this ran on Linux
# and Windows and died on every Mac with `SDK_NOTE: unbound variable`, an
# empty README and exit 1. Redirecting a plain heredoc into sed keeps the
# heredoc out of a substitution, so prose can contain anything.
NOTE_SDK="$NAME/.starling-sdk-note"
NOTE_SHIP="$NAME/.starling-ship-note"

if [ "$PLATFORM" = windows ]; then
    sed "s|@SDKDIR@|$SDK_REF|g" > "$NOTE_SDK" <<'NOTE'
`Package.swift` names the shared SDK cache directly (@SDKDIR@) — the
Flutter-to-Swift framework plus the engine binaries it links against. Git for
Windows cannot create the symlink the other platforms get, so the path is
written into the manifest instead. Anyone cloning this project re-creates the
cache with:
NOTE
    sed "s|@MODULE@|$MODULE|g" > "$NOTE_SHIP" <<'NOTE'
Windows resolves imports from the executable's own directory, so deployment is
a copy and everything must land in ONE directory:

```cmd
mkdir dist
copy .build\release\@MODULE@.exe dist\
copy sdk\engine\lib\*.dll        dist\
xcopy /E /I sdk\engine\share     dist\data
copy sdk\Vendor\conpty\*         dist\
```

The Swift runtime DLLs are deliberately NOT in the SDK — they belong to your
toolchain — so copy those beside the .exe as well, from its
`Runtimes\<version>\usr\bin`. Miss any DLL and the app dies with
`STATUS_DLL_NOT_FOUND` (0xC0000135) before `main`, with no message at all.

`conpty.dll` and `OpenConsole.exe` matter only if you use TerminalView. Without
them it still works: it falls back to the inbox console host, silently, at
roughly three times the CPU on the read path.
NOTE
else
    sed "s|@SDKHOME@|$SDK_HOME|g" > "$NOTE_SDK" <<'NOTE'
`sdk` is a symlink into the shared SDK cache (@SDKHOME@) — the
Flutter-to-Swift framework plus the engine binaries it links against. It is
gitignored, so anyone cloning this project re-creates it with:
NOTE
    sed "s|@MODULE@|$MODULE|g" > "$NOTE_SHIP" <<'NOTE'
The rpath points into the cache, which is useless on someone else's machine.
SwiftPM also puts `$ORIGIN` in the rpath, so deployment is a copy:

```bash
mkdir -p dist
cp .build/release/@MODULE@  dist/
cp sdk/engine/lib/*.so      dist/     # sits beside the binary
cp -r sdk/engine/share      dist/     # icudtl.dat + flutter_assets
```

Skip the library copy and it dies at startup on
`libflutter_engine.so: cannot open shared object file` — at run time, not
build time.
NOTE
fi

cat > "$NAME/README.md" <<README
# $NAME

Built with \`starling-create\`. Run it:

\`\`\`bash
swift run -c release
\`\`\`

$(cat "$NOTE_SDK")

\`\`\`bash
curl -fLO $SDK_BASE_URL/starling-create
chmod +x starling-create
./starling-create --sdk $SDK_URL $NAME
\`\`\`

## Shipping it

$(cat "$NOTE_SHIP")
README
rm -f "$NOTE_SDK" "$NOTE_SHIP"

say ""
say "    $NAME/"
say "      Package.swift"
say "      Sources/$MODULE/main.swift"
say "      $SDK_SHOWN"
say ""

if [ "$RUN" = 1 ]; then
    say "==> building and running (release)"
    if [ "$PLATFORM" = windows ]; then
        # `swift run` builds fine here and then dies before main(): Windows
        # resolves imports from the executable's own directory, and SwiftPM
        # puts nothing there but the .exe. So stage the engine beside it and
        # run it directly -- the same layout the README's dist\ step describes,
        # which is why the first run teaches the deployment rule rather than
        # hiding it. Each copy is an `if`, not an `&&` chain: under `set -e` a
        # chain ending in a false test takes the whole script down.
        ( cd "$NAME" && swift build -c release )
        BIN="$NAME/.build/release"
        cp "$SDK_DIR"/engine/lib/*.dll "$BIN"/
        mkdir -p "$BIN/data"
        cp -r "$SDK_DIR"/engine/share/. "$BIN/data"/
        if [ -d "$SDK_DIR/Vendor/conpty" ]; then
            cp "$SDK_DIR"/Vendor/conpty/* "$BIN"/
        fi
        ( cd "$BIN" && "./$MODULE.exe" )
    else
        ( cd "$NAME" && swift run -c release )
    fi
else
    say "Next:"
    say ""
    say "    cd $NAME"
    say "    swift run -c release"
    say ""
fi
